# Copy to .env.local and fill in. .env.local is git-ignored; never commit real values.
# The app refuses to start, and `pnpm db:migrate` exits, while this is unset.

# Postgres connection string (Neon in production, any Postgres locally).
# Local example: docker run -d -e POSTGRES_USER=dev -e POSTGRES_PASSWORD=dev -e POSTGRES_DB=observatory -p 5432:5432 postgres:17-alpine
DATABASE_URL=postgres://dev:dev@localhost:5432/observatory

# Optional, tests only: a throwaway database (name must end in _test) for the migration integration test
# (`TEST_DATABASE_URL=... pnpm test`). Its schema is dropped on every run.
# TEST_DATABASE_URL=postgres://dev:dev@localhost:5432/observatory_test
